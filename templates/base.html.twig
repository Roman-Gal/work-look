<!DOCTYPE html>
<html lang="{{ app.request.locale }}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="turbo-cache-control" content="no-cache"><title>{% block title %}{{ 'app.title'|trans }}{% endblock %}</title><link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml"><link rel="preload" href="{{ asset('fonts/zakon/Zakon-Regular.ttf') }}" as="font" type="font/ttf" crossorigin><link rel="stylesheet" href="{{ asset('styles/fonts.css') }}"><link rel="stylesheet" href="{{ asset('styles/app.css') }}">{{ importmap('app', {nonce: app.request.attributes.get('csp_nonce')}) }}</head>
<body>{% if app.user %}<div class="app-shell"><aside class="sidebar">
<a class="brand" href="{{ path('app_dashboard') }}"><span class="brand-mark">w.</span><span>worklook<span class="green">.</span></span></a><div class="sidebar-caption">{{ 'nav.workspace'|trans }}</div>
<nav aria-label="{{ 'nav.label'|trans }}"><a class="nav-link {{ app.request.attributes.get('_route') in ['app_dashboard', 'app_run', 'app_match'] ? 'active' : '' }}" href="{{ path('app_dashboard') }}"><span class="nav-icon">▦</span> {{ 'nav.search'|trans }}</a><a class="nav-link {{ app.request.attributes.get('_route') == 'app_profile' ? 'active' : '' }}" href="{{ path('app_profile') }}"><span class="nav-icon">◉</span> {{ 'nav.profile'|trans }}</a>{% if is_granted('ROLE_ADMIN') %}<a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_admin' ? 'active' : '' }}" href="{{ path('app_admin') }}"><span class="nav-icon">▥</span> {{ 'admin.nav'|trans }}</a>{% endif %}</nav>
<div class="sidebar-note"><span class="eyebrow">{{ 'nav.control'|trans }}</span><p>{{ 'nav.agent_prepares'|trans }}<br>{{ 'nav.you_review'|trans }}</p><span class="small-pill">{{ 'nav.verified'|trans }}</span></div>
<div class="account"><div class="avatar">{{ app.user.email|first|upper }}</div><div class="account-info"><strong>{{ 'nav.account'|trans }}</strong><span>{{ app.user.email }}</span></div></div><form action="{{ path('app_logout') }}" method="post"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout" type="submit">{{ 'nav.logout'|trans }}</button></form></aside>
<div class="workspace"><header class="topbar"><span>{{ 'nav.focus'|trans }}</span>{% include '_language_switcher.html.twig' %}<span class="private-label"><i></i> {{ 'nav.private'|trans }}</span></header><main>{% for type, messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}" role="status">{{ message|trans }}</div>{% endfor %}{% endfor %}{% block content %}{% endblock %}</main><footer class="footer">WorkLook <span>{{ 'app.footer'|trans }}</span></footer></div></div>{% else %}{% block guest %}{% endblock %}{% endif %}</body></html>
