{% extends 'base.html.twig' %}
{% block content %}
{% set contentLocale = resultLocale %}
<a class="back-link" href="{{ path('app_local_requests') }}">{{ 'batch.history'|trans }}</a><h1>{{ job.input.search_request }}</h1><span class="badge status-{{ job.status }}">{{ ('batch.status.' ~ job.status)|trans }}</span>
<div class="request-settings section"><strong>{{ 'workflow.sources'|trans }}</strong><div class="source-badges">{% for id in job.input.selected_sources|default([]) %}<a class="badge" href="{{ sourceCatalog[id].url }}" target="_blank" rel="noopener noreferrer">{{ sourceCatalog[id].name }}</a>{% else %}<span class="help-text">{{ 'workflow.legacy_sources'|trans }}</span>{% endfor %}</div><p class="help-text">{{ 'workflow.language'|trans }}: {{ ('workflow.language.' ~ contentLocale)|trans }}</p></div>
{% if job.status != 'completed' %}<section class="panel section"><h2>{{ 'batch.wait_title'|trans }}</h2><p>{{ 'batch.wait'|trans }}</p></section>{% else %}
<section class="panel section" lang="{{ contentLocale }}"><p class="description-text">{{ job.result.summary }}</p><p class="help-text">{{ 'batch.review_help'|trans({},null,contentLocale) }}</p></section>
{% if job.result.source_report|default([]) %}<section class="panel section" lang="{{ contentLocale }}"><h2>{{ 'workflow.coverage'|trans({},null,contentLocale) }}</h2>{% for report in job.result.source_report %}<div class="source-report"><strong>{{ sourceCatalog[report.source].name }}</strong><span class="badge">{{ ('workflow.source_status.' ~ report.status)|trans({},null,contentLocale) }}</span><p class="description-text">{{ report.details }}</p>{% if report.checked_urls %}<details><summary>{{ 'workflow.checked_pages'|trans({},null,contentLocale) }}</summary><ul>{% for url in report.checked_urls %}<li><a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ url }}</a></li>{% endfor %}</ul></details>{% endif %}</div>{% endfor %}</section>{% endif %}
{% for match in job.result.matches %}<article class="panel section" lang="{{ contentLocale }}">{% if match.conclusion|default('') %}<div class="cv-conclusion" role="note"><strong>{{ 'workflow.conclusion'|trans({},null,contentLocale) }}</strong><p class="description-text">{{ match.conclusion }}</p>{% if match.adaptations|default([]) %}<ul>{% for change in match.adaptations %}<li{% if change.kind == 'inference' %} class="adaptation-inference"{% endif %}><strong>{{ ('workflow.change.' ~ change.kind)|trans({},null,contentLocale) }}</strong>: {{ change.description }}{% if change.kind == 'inference' %}<p>{{ 'workflow.confirm_inference'|trans({},null,contentLocale) }}</p>{% endif %}<details><summary>{{ 'workflow.source_basis'|trans({},null,contentLocale) }}</summary><p>{{ change.basis }}</p></details></li>{% endfor %}</ul>{% endif %}</div>{% endif %}<h2>{{ match.title }}</h2><p>{{ match.company }} · {{ match.location }}{% if match.source|default('') %} · {{ sourceCatalog[match.source].name }}{% endif %}</p><p class="salary">{{ match.salary }}</p><h3>{{ 'batch.fit'|trans({},null,contentLocale) }}</h3><p class="description-text">{{ match.fit }}</p><h3>{{ 'batch.gaps'|trans({},null,contentLocale) }}</h3><p class="description-text">{{ match.gaps }}</p><p class="help-text">{{ 'batch.checked'|trans({},null,contentLocale) }}: {{ match.checked_at }}</p><a class="button secondary" href="{{ match.url }}" target="_blank" rel="noopener noreferrer">{{ 'batch.vacancy'|trans({},null,contentLocale) }}</a>{% if match.cv_text %} <a class="button primary" href="{{ path('app_local_cv',{id:job.id,index:loop.index0}) }}">{{ 'batch.cv'|trans({},null,contentLocale) }}</a><details><summary>{{ 'resume.review'|trans({},null,contentLocale) }}</summary><p class="description-text">{{ match.cv_text }}</p></details>{% endif %}</article>{% endfor %}{% endif %}
<form action="{{ path('app_local_remove',{id:job.id}) }}" method="post" class="section" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('local_work_remove_' ~ job.id) }}"><button class="button secondary">{{ 'batch.remove'|trans }}</button><p class="help-text">{{ 'batch.remove_help'|trans }}</p></form>
{% endblock %}
