{% extends 'base.html.twig' %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">WORKLOOK</span><h1>{{ 'batch.title'|trans }}</h1><p class="muted">{{ 'batch.intro'|trans }}</p></div><a class="button secondary" href="{{ path('app_resume') }}">{{ 'resume.title'|trans }}</a></div>
<div class="dashboard-grid"><section class="panel"><h2>{{ 'batch.new'|trans }}</h2><p>{{ 'batch.wait'|trans }}</p>{% if draft and draft.pdfData and draft.requestText %}<div class="notice"><strong>{{ draft.filename }}</strong><span>{{ draft.requestText }}</span></div><form action="{{ path('app_local_start') }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('local_work_start') }}">{% include 'local_work/_options.html.twig' %}<button class="button primary">{{ 'batch.submit'|trans }}</button></form>{% else %}<p>{{ 'batch.setup'|trans }}</p><a class="button primary" href="{{ path('app_resume') }}">{{ 'resume.upload'|trans }}</a>{% endif %}</section><aside class="panel how-panel"><h2>{{ 'batch.how'|trans }}</h2><ol class="workflow-steps"><li><strong>{{ 'workflow.step1'|trans }}</strong><p>{{ 'workflow.step1_help'|trans }}</p></li><li><strong>{{ 'workflow.step2'|trans }}</strong><p>{{ 'workflow.step2_help'|trans }}</p></li><li><strong>{{ 'workflow.step3'|trans }}</strong><p>{{ 'workflow.step3_help'|trans }}</p></li></ol><p>{{ 'dashboard.no_auto_apply'|trans }}</p><a class="back-link" href="{{ path('app_cv_privacy') }}">{{ 'batch.privacy'|trans }}</a></aside></div>
<section class="panel section"><h2><a href="{{ path('app_local_requests') }}">{{ 'batch.history'|trans }}</a></h2>{% include 'local_work/_list.html.twig' %}</section>
{% endblock %}
