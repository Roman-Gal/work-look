{% for job in jobs %}<a class="run-row" href="{{ path('app_local_result',{id:job.id}) }}"><span class="run-icon">▤</span><div class="grow"><strong>{{ job.input.search_request }}</strong><span>{{ job.createdAt|date('d.m.Y H:i','Europe/Warsaw') }}</span></div><span class="badge status-{{ job.status }}">{{ ('batch.status.' ~ job.status)|trans }}</span></a>{% else %}<div class="empty-state"><h3>{{ 'batch.empty'|trans }}</h3></div>{% endfor %}
