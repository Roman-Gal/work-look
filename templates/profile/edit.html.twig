{% extends 'base.html.twig' %}
{% block title %}{{ 'profile.title'|trans }}{% endblock %}
{% block content %}<div class="page-heading"><div><span class="eyebrow">{{ 'profile.eyebrow'|trans }}</span><h1>{{ 'profile.heading'|trans }}<span class="green">.</span></h1><p class="muted">{{ 'profile.intro'|trans }}</p></div></div><p><a class="back-link" href="{{ path('app_resume') }}">← {{ 'resume.title'|trans }}</a></p>{% if preparedDraft|default(null) %}<div class="notice"><strong>{{ 'resume.confirm_heading'|trans }}</strong><span>{{ 'resume.confirm_help'|trans }}</span></div>{% endif %}<div class="profile-grid"><section class="panel"><h2>{{ 'profile.canonical'|trans }}</h2>{{ form_start(form, {attr: {'data-turbo': 'false'}}) }}{{ form_row(form.displayName) }}{{ form_row(form.headline) }}{{ form_row(form.contactLine) }}{{ form_row(form.searchTerms) }}{{ form_row(form.factsText) }}{{ form_row(form.preferences) }}<button class="button primary" type="submit">{{ 'profile.save'|trans }}</button>{{ form_end(form) }}</section><aside class="panel profile-aside"><span class="eyebrow">{{ 'profile.principle'|trans }}</span><h2>{{ 'profile.trust'|trans }}</h2><p>{{ 'profile.facts_hint'|trans }}</p><p>{{ 'profile.reorder_hint'|trans }}</p><div class="notice"><strong>{{ 'profile.versions'|trans }}</strong><span>{{ 'profile.snapshot_hint'|trans }}</span></div></aside></div>{% endblock %}
