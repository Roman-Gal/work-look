<article class="panel job-card"><div class="job-card-top"><span class="source-tag">{{ match.jobSnapshot.source|upper }}</span><span class="score">{{ match.score }}<small>/100</small></span></div><h3><a href="{{ path('app_match', {id: match.id}) }}" data-turbo-frame="_top">{{ match.jobSnapshot.title }}</a></h3><p class="company">{{ match.jobSnapshot.company ? (match.jobSnapshot.company) : 'match.no_company'|trans }}</p><div class="job-meta"><span>{{ match.jobSnapshot.locations ? (match.jobSnapshot.locations|join(', ')) : 'match.no_location'|trans }}</span><span>{{ {remote: 'work.remote'|trans, hybrid: 'work.hybrid'|trans, office: 'work.office'|trans, unknown: 'work.unknown'|trans}[match.jobSnapshot.work_mode]|default('match.verify'|trans) }}</span></div><div class="job-card-bottom"><span class="badge">{{ ('status.' ~ match.status)|trans }}</span><a href="{{ path('app_match', {id: match.id}) }}" data-turbo-frame="_top">{{ 'match.view'|trans }} {{ match.selectedFactIds ? 'match.cv_ready'|trans : '' }} →</a></div></article>
