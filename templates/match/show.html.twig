{% extends 'base.html.twig' %}
{% block title %}{{ match.run.mode == 'demo' ? match.jobSnapshot.title|trans : match.jobSnapshot.title }} — WorkLook{% endblock %}
{% block content %}<a class="back-link" href="{{ path('app_run', {id: match.run.id}) }}">{{ 'match.back'|trans }}</a><div class="page-heading"><div><span class="eyebrow">{{ match.run.mode == 'demo' ? 'match.demo_job'|trans : match.jobSnapshot.source|upper }}</span><h1>{{ match.run.mode == 'demo' ? match.jobSnapshot.title|trans : match.jobSnapshot.title }}</h1><p class="muted">{{ match.run.mode == 'demo' ? match.jobSnapshot.company|trans : match.jobSnapshot.company }} · {{ match.run.mode == 'demo' ? 'demo.location'|trans : match.jobSnapshot.locations|join(', ') }}</p></div><span class="score large">{{ match.score }}<small>/100</small></span></div>
<div class="profile-grid"><div><section class="panel"><div class="section-title"><h2>{{ 'match.fit'|trans }}</h2><span class="badge">{{ ('status.' ~ match.status)|trans }}</span></div><h3 class="green">{{ 'match.reasons'|trans }}</h3><ul class="reason-list">{% for reason in match.reasons %}<li>{{ match.run.mode == 'demo' ? reason|trans : reason }}</li>{% endfor %}</ul><h3>{{ 'match.gaps'|trans }}</h3><ul class="reason-list">{% for gap in match.gaps %}<li>{{ match.run.mode == 'demo' ? gap|trans : gap }}</li>{% else %}<li>{{ 'match.no_gaps'|trans }}</li>{% endfor %}</ul></section><section class="panel section"><h2>{{ 'match.details'|trans }}</h2>{% for salary in match.jobSnapshot.salaries %}<p class="salary">{{ salary.min ?? '?' }} – {{ salary.max ?? '?' }} {{ salary.currency ?? 'match.currency_unknown'|trans }} / {{ salary.period ?? '?' }} · {{ salary.contract_type ?? 'match.contract_unknown'|trans }}<small>{{ 'match.gross_net'|trans }}</small></p>{% else %}<p class="muted">{{ 'match.salary_unknown'|trans }}</p>{% endfor %}<p class="description-text">{{ match.run.mode == 'demo' ? match.jobSnapshot.description|trans : match.jobSnapshot.description }}</p><a class="button secondary" href="{{ match.jobSnapshot.url }}" target="_blank" rel="noopener noreferrer">{{ 'match.source'|trans }}</a></section></div>
<aside><section class="panel"><h2>{{ 'match.next_step'|trans }}</h2><p class="muted">{{ 'match.status_hint'|trans }}</p><form action="{{ path('app_match_status', {id: match.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('status_' ~ match.id) }}"><label for="status">{{ 'match.status'|trans }}</label><select id="status" name="status">{% for value, label in {New: 'status.New', Reviewed: 'status.Reviewed', Applied: 'status.Applied', Skipped: 'status.Skipped'} %}<option value="{{ value }}" {{ match.status == value ? 'selected' : '' }}>{{ label|trans }}</option>{% endfor %}</select><button class="button primary full" type="submit">{{ 'match.save_status'|trans }}</button></form></section><section class="panel section"><span class="eyebrow">{{ 'match.verified'|trans }}</span><h2>{{ 'match.cv'|trans }}</h2>{% if facts %}<p class="muted">{{ 'match.selected'|trans({'%count%': facts|length}) }}</p><a class="button primary full" data-turbo="false" href="{{ path('app_cv_pdf', {id: match.id}) }}">{{ 'match.download'|trans }}</a><details><summary>{{ 'match.provenance'|trans }}</summary>{% for fact in facts %}<p>{{ fact.text }}<small class="fact-id">{{ fact.id }}</small></p>{% endfor %}</details>{% else %}<p class="muted">{{ 'match.no_cv'|trans }}</p>{% endif %}</section></aside></div>{% endblock %}
