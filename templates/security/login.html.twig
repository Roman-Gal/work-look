{% extends 'base.html.twig' %}
{% block title %}{{ 'login.title'|trans }}{% endblock %}
{% block guest %}<div class="login-layout"><section class="login-story"><a class="brand" href="{{ path('app_login') }}"><span class="brand-mark">w.</span><span>worklook.</span></a><span class="eyebrow">{{ 'login.eyebrow'|trans }}</span><h1>{{ 'login.less'|trans }}<br>{{ 'login.more'|trans }}<br><em>{{ 'login.opportunities'|trans }}</em></h1><p>{{ 'login.story'|trans }}</p><div class="story-bottom">{{ 'login.coverage'|trans }}</div></section><section class="login-panel"><div class="login-card">{% include '_language_switcher.html.twig' %}<span class="eyebrow">{{ 'login.welcome'|trans }}</span><h2>{{ 'login.heading'|trans }}</h2><p class="muted">{{ 'login.private'|trans }}</p>{% if error %}<div class="flash warning" role="alert">{{ 'login.error'|trans }}</div>{% endif %}
<form method="post" action="{{ path('app_login') }}" data-turbo="false"><label for="email">Email</label><input id="email" type="email" name="_username" value="{{ last_username }}" required autocomplete="username" maxlength="180"><label for="password">{{ 'login.password'|trans }}</label><input id="password" type="password" name="_password" required autocomplete="current-password"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="button primary full" type="submit">{{ 'login.submit'|trans }} <span>→</span></button></form><p class="login-help">{{ 'login.help'|trans }}</p></div></section></div>{% endblock %}
