<!doctype html><html lang="{{ locale }}"><head><meta charset="utf-8"><style>@font-face{font-family:'Zakon Text';src:url('{{ origin }}{{ asset('fonts/zakon/Zakon-Regular.ttf') }}') format('truetype')}body{font-family:'Zakon Text',Georgia,serif}</style></head><body style="margin:0;background:{{ brand.color('bg') }};color:{{ brand.color('ink') }};font-family:'Zakon Text',Georgia,serif"><table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr><td align="center" style="padding:36px 16px"><table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:100%;max-width:560px;background:{{ brand.color('surface') }};border:1px solid {{ brand.color('line') }};border-radius:12px"><tr><td style="padding:32px"><p style="font-size:25px;color:{{ brand.color('green') }}">worklook.</p><h1 style="font-size:24px;line-height:1.3">{{ subject }}</h1><p style="font-size:16px;line-height:1.7">{{ body }}</p><p style="margin:28px 0"><a href="{{ link }}" style="background:{{ brand.color('green') }};color:{{ brand.color('surface') }};padding:14px 22px;text-decoration:none;border-radius:8px;display:inline-block">{{ button }}</a></p><p style="font-size:13px;color:{{ brand.color('muted') }};word-break:break-all">{{ link }}</p></td></tr></table></td></tr></table></body></html>

