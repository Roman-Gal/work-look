<!doctype html>
<html lang="{{ language|default('uk') }}">
<head><meta charset="UTF-8"><style>
@page { margin: 15mm 17mm 19mm; }
body { margin: 0; font-family: "Zakon Text", serif; font-size: 10.2pt; line-height: 1.32; color: {{ brand.color('ink') }}; }
a { color: {{ brand.color('green') }}; text-decoration: underline; overflow-wrap: break-word; word-wrap: break-word; }
* { box-sizing: border-box; }
.cv-header { background: {{ brand.color('pale') }}; border-left: 4pt solid {{ brand.color('green') }}; padding: 12pt 18pt 11pt; margin: 0 0 13pt; page-break-inside: avoid; }
h1 { font-size: 25pt; line-height: 1.16; font-weight: 700; margin: 0 0 6pt; color: {{ brand.color('ink') }}; overflow-wrap: break-word; }
.headline { font-size: 11.2pt; margin: 0 0 6pt; color: {{ brand.color('green') }}; }
.contacts { font-size: 8.6pt; line-height: 1.4; color: {{ brand.color('muted') }}; overflow-wrap: break-word; word-wrap: break-word; }
.source-links { font-size: 8.3pt; line-height: 1.4; margin-top: 5pt; overflow-wrap: break-word; word-wrap: break-word; }
.source-links a { white-space: nowrap; }
.cv-section { margin: 0 0 10pt; }
h2 { color: {{ brand.color('green') }}; font-size: 9pt; font-weight: 700; letter-spacing: 1.15pt; line-height: 1.4; margin: 0 0 6pt; padding: 0 0 4pt; border-bottom: .6pt solid {{ brand.color('line') }}; page-break-after: avoid; }
p { margin: 0 0 5pt; white-space: pre-line; overflow-wrap: break-word; word-wrap: break-word; orphans: 3; widows: 3; }
.subheading { font-weight: 700; font-size: 10.5pt; margin: 0 0 2pt; page-break-after: avoid; }
.meta { font-size: 9pt; color: {{ brand.color('muted') }}; margin: 0 0 7pt; page-break-after: avoid; }
ul { margin: 3pt 0 0; padding-left: 14pt; }
li { margin: 0 0 2.5pt; padding-left: 2pt; orphans: 2; widows: 2; }
.skills-box { background: {{ brand.color('bg') }}; border: .5pt solid {{ brand.color('line') }}; padding: 8pt 12pt; }
.skill-line { margin: 0 0 2pt; font-size: 9.8pt; }
.compact-row { width: 100%; border-collapse: collapse; margin: 0 0 5pt; page-break-inside: avoid; table-layout: fixed; }
.compact-row td { vertical-align: top; width: 50%; padding: 0; }
.compact-row td:first-child { padding-right: 14pt; }
.compact-row td:last-child { padding-left: 14pt; }
.compact-row p { font-size: 9.3pt; }
.cv-note { color: {{ brand.color('muted') }}; font-size: 7.4pt; margin-top: 15pt; }
.worklook-credit { position: fixed; left: 0; right: 0; bottom: -34pt; text-align: center; font-size: 6.2pt; line-height: 1.3; color: {{ brand.color('cv-credit') }}; }
.worklook-credit a { color: {{ brand.color('cv-credit') }}; text-decoration: none; }
</style></head>
<body>
<div class="worklook-credit">Powered by {% if cvBrandUrl %}<a href="{{ cvBrandUrl }}">WorkLook</a>{% else %}WorkLook{% endif %}</div>
{% block cv_content %}{% endblock %}
</body></html>
