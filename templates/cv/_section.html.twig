<section class="cv-section{% if section.kind == 'links' %} cv-links{% endif %}">
{% if section.heading %}<h2>{{ section.heading }}</h2>{% endif %}
{% if section.kind == 'skills' %}<div class="skills-box">{% endif %}
{% for block in section.blocks %}
    {% if block.type == 'list' %}<ul>{% for item in block.items %}<li>{{ cvLinks.render(item, section.kind == 'links') }}</li>{% endfor %}</ul>
    {% elseif block.type == 'subheading' %}<p class="subheading">{{ cvLinks.render(block.text, section.kind == 'links') }}</p>
    {% elseif block.type == 'meta' %}<p class="meta">{{ cvLinks.render(block.text, section.kind == 'links') }}</p>
    {% elseif block.type == 'skill' %}<p class="skill-line">{{ cvLinks.render(block.text, section.kind == 'links') }}</p>
    {% else %}<p>{{ cvLinks.render(block.text, section.kind == 'links') }}</p>{% endif %}
{% endfor %}
{% if section.kind == 'skills' %}</div>{% endif %}
</section>
