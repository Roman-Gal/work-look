<!DOCTYPE html><html lang="{{ app.request.locale }}"><head><meta charset="UTF-8"><style>body{font-family:"Zakon Text",serif;font-size:10pt;color:{{ brand.color('ink') }};line-height:1.6;margin:30px}h1{font-size:24pt;margin-bottom:2px}h2{font-size:13pt;border-bottom:1px solid {{ brand.color('line') }};padding-bottom:8px}.contact{color:{{ brand.color('muted') }};font-size:9pt}.target{margin-top:28px}li{margin-bottom:12px}.footer{margin-top:28px;font-size:8pt;color:{{ brand.color('muted') }}}</style></head><body><h1>{{ profile.display_name }}</h1><p>{{ profile.headline }}</p><p class="contact">{{ profile.contact_line }}</p><p class="target">{{ 'cv.target'|trans }} {{ match.jobSnapshot.title }}</p><h2>{{ 'cv.experience'|trans }}</h2><ul>{% for fact in facts %}<li>{{ fact.text }}</li>{% endfor %}</ul><p class="footer">{{ 'cv.footer'|trans }} {{ profile.version|slice(0, 12) }}.</p></body></html>
