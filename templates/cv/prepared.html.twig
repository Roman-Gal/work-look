{% extends 'cv/layout.html.twig' %}
{% block cv_content %}
{% if cv.name or cv.headline or cv.contacts or sourceLinks|default([]) %}<header class="cv-header">
{% if cv.name %}<h1>{{ cv.name }}</h1>{% endif %}
{% if cv.headline %}<p class="headline">{{ cvLinks.render(cv.headline) }}</p>{% endif %}
{% if cv.contacts %}<div class="contacts">{% for contact in cv.contacts %}{{ cvLinks.render(contact) }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>{% endif %}
{% if sourceLinks|default([]) and sourceLinks|length <= 4 %}<div class="source-links">{% for link in sourceLinks %}{{ cvLinks.link(link) }}{% if not loop.last %} | {% endif %}{% endfor %}</div>{% endif %}
</header>{% endif %}
{% for row in cv.rows %}
{% if row|length == 2 %}<table class="compact-row"><tr>{% for section in row %}<td>{% include 'cv/_section.html.twig' %}</td>{% endfor %}</tr></table>
{% else %}{% for section in row %}{% include 'cv/_section.html.twig' %}{% endfor %}{% endif %}
{% endfor %}
{% if sourceLinks|default([]) and sourceLinks|length > 4 %}<section class="cv-section"><h2>Links</h2>{% for link in sourceLinks %}<p>{{ cvLinks.link(link) }}</p>{% endfor %}</section>{% endif %}
{% endblock %}
