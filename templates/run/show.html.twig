{% extends 'base.html.twig' %}
{% block title %}{{ 'run.title'|trans }}{% endblock %}
{% block content %}{% if run.user.id == app.user.id %}<p><a class="back-link" href="{{ path('app_knowledge_prompt_new', {run: run.id}) }}">{{ 'kb.new_private'|trans }} +</a></p>{% endif %}<a class="back-link" href="{{ path('app_dashboard') }}">{{ 'run.back'|trans }}</a><div class="page-heading"><div><span class="eyebrow">{{ 'run.live'|trans }}</span><h1>{{ 'run.heading'|trans }}<span class="green">.</span></h1><p class="muted">{{ run.createdAt|date('d.m.Y · H:i', 'Europe/Warsaw') }} · {{ run.sources|join(' · ') }}</p></div></div>
<turbo-frame id="run-progress" {% if run.active %}data-controller="run-poll" data-run-poll-url-value="{{ path('app_run', {id: run.id}) }}"{% endif %}><div class="run-summary panel" data-run-active="{{ run.active ? '1' : '0' }}"><div>{% include 'run/_status.html.twig' %}<p>{{ (run.summary ?: 'run.wait')|trans }}</p>{% if run.status == 'queued' %}<p class="muted">{{ 'run.worker_hint'|trans }}</p>{% endif %}</div><div class="run-counters"><span><strong>{{ run.modelCalls }}</strong> {{ 'run.model_calls'|trans }}</span><span><strong>{{ run.toolCalls }}</strong> {{ 'run.tool_calls'|trans }}</span><span><strong>{{ run.totalTokens|number_format(0, '.', ' ') }}</strong> {{ 'run.tokens'|trans }}</span></div></div><section class="panel timeline-panel"><div class="section-title"><h2>{{ 'run.log'|trans }}</h2>{% if run.active %}<span class="live-indicator">{{ 'run.auto_update'|trans }}</span>{% endif %}</div><ol class="timeline">{% for event in run.events %}<li class="event-{{ event.level }}"><time>{{ event.at|date('H:i:s', 'Europe/Warsaw') }}</time><span>{% set parameters = event.parameters|default({}) %}{{ event.message|trans(parameters) }}</span></li>{% endfor %}</ol></section>{% if matches %}<section class="section"><div class="section-title"><h2>{{ 'run.results'|trans }}</h2><span class="muted">{{ 'run.match_count'|trans({'%count%': matches|length}) }}</span></div><div class="job-grid">{% for match in matches %}{% include 'match/_card.html.twig' %}{% endfor %}</div></section>{% endif %}
{% if run.active %}<form action="{{ path('app_run_cancel', {id: run.id}) }}" method="post" class="cancel-form"><input type="hidden" name="_token" value="{{ csrf_token('cancel_' ~ run.id) }}"><button class="button secondary" type="submit">{{ 'run.stop'|trans }}</button></form>{% endif %}</turbo-frame>{% endblock %}
