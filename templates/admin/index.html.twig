{% extends 'base.html.twig' %}
{% block title %}{{ 'admin.statistics'|trans }} · WorkLook{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">WORKLOOK / {{ 'admin.owner'|trans }}</span><h1>{{ 'admin.statistics'|trans }}</h1><p class="muted">{{ 'admin.intro'|trans }}</p></div><span class="small-pill">{{ 'admin.timezone'|trans }}</span></div>
{% include 'admin/_tabs.html.twig' %}
<form class="admin-period" method="get"><label for="period">{{ 'admin.period'|trans }}</label><select id="period" name="days">{% for days in [1, 7, 30, 90] %}<option value="{{ days }}" {{ days == filters.days ? 'selected' : '' }}>{{ 'admin.days'|trans({'%count%': days}) }}</option>{% endfor %}</select><button class="button secondary">{{ 'admin.apply'|trans }}</button></form>
<div class="stats-grid">
    <div class="stat"><span>{{ 'admin.views'|trans }}</span><strong>{{ report.web.views }}</strong><small>{{ 'admin.views_help'|trans }}</small></div>
    <div class="stat"><span>{{ 'admin.visitors'|trans }}</span><strong>{{ report.web.visitors }}</strong><small>{{ 'admin.visitors_help'|trans }}</small></div>
    <div class="stat"><span>{{ 'admin.logins'|trans }}</span><strong>{{ report.web.logins }}</strong><small>{{ 'admin.failures'|trans }}: {{ report.web.failures }}</small></div>
    <div class="stat"><span>{{ 'admin.users'|trans }}</span><strong>{{ userCount }}</strong><a href="{{ path('app_admin_users') }}">{{ 'admin.manage'|trans }} →</a></div>
</div>
<section class="panel admin-chart"><div class="section-title"><h2>{{ 'admin.activity'|trans }}</h2><span class="muted">{{ 'admin.chart_utc'|trans }}</span></div>
{% set peak = 1 %}{% for day in report.daily %}{% set peak = max(peak, day.views) %}{% endfor %}
{% if report.daily|length %}<svg viewBox="0 0 900 150" role="img" aria-label="{{ 'admin.activity'|trans }}"><line x1="0" y1="119" x2="900" y2="119" class="chart-axis"/>{% for day in report.daily %}{% set width = 900 / report.daily|length %}{% set height = day.views / peak * 95 %}<rect x="{{ loop.index0 * width + width * 0.15 }}" y="{{ 118 - height }}" width="{{ width * 0.7 }}" height="{{ max(1, height) }}" rx="3" class="chart-bar"><title>{{ day.day }}: {{ day.views }} {{ 'admin.views'|trans }}, {{ day.logins }} {{ 'admin.logins'|trans }}</title></rect>{% if loop.first or loop.last or report.daily|length < 9 %}<text x="{{ loop.index0 * width + width / 2 }}" y="140" text-anchor="middle">{{ day.day|slice(5) }}</text>{% endif %}{% endfor %}</svg>{% else %}<p class="muted">{{ 'admin.empty'|trans }}</p>{% endif %}
</section>
<div class="admin-split section">
<section class="panel"><h2>{{ 'admin.countries'|trans }}</h2>{% for country in report.countries %}<div class="admin-rank"><a href="{{ path('app_admin', {days: filters.days, country: country.country}) }}#events">{{ country.country ?: 'admin.unknown'|trans }}</a><meter min="0" max="{{ max(1, report.web.views) }}" value="{{ country.views }}">{{ country.views }}</meter><strong>{{ country.views }}</strong></div>{% else %}<p class="muted">{{ 'admin.empty'|trans }}</p>{% endfor %}<p class="help-text">{{ 'admin.geo_help'|trans }} {% if not geoAvailable %}{{ 'admin.geo_missing'|trans }}{% endif %}</p><a class="help-text" href="https://db-ip.com" rel="noreferrer">IP Geolocation by DB-IP</a></section>
<section class="panel"><h2>{{ 'admin.sources'|trans }}</h2>{% for source in report.sources %}<div class="admin-rank"><span>{{ source.referrer_host ?: 'admin.direct'|trans }}</span><meter min="0" max="{{ max(1, report.web.views) }}" value="{{ source.views }}">{{ source.views }}</meter><strong>{{ source.views }}</strong></div>{% else %}<p class="muted">{{ 'admin.empty'|trans }}</p>{% endfor %}<p class="help-text">{{ 'admin.sources_help'|trans }}</p></section>
</div>
<section class="panel section" id="events"><div class="section-title"><h2>{{ 'admin.events'|trans }}</h2><span class="muted">{{ report.count }} {{ 'admin.records'|trans }}</span></div>
<form method="get" class="admin-filters"><input type="hidden" name="days" value="{{ filters.days }}"><div><label for="kind">{{ 'admin.event'|trans }}</label><select name="kind" id="kind"><option value="">{{ 'admin.all'|trans }}</option>{% for kind in kinds %}<option value="{{ kind }}" {{ filters.kind == kind ? 'selected' : '' }}>{{ ('admin.kind.' ~ kind)|trans }}</option>{% endfor %}</select></div><div><label for="country">{{ 'admin.country'|trans }}</label><input name="country" id="country" maxlength="2" placeholder="PL" value="{{ filters.country }}"></div><div class="admin-search"><label for="q">{{ 'admin.search'|trans }}</label><input name="q" id="q" value="{{ filters.q }}" placeholder="{{ 'admin.search_hint'|trans }}" maxlength="180"></div><label class="admin-checkbox"><input type="checkbox" name="errors" value="1" {{ filters.errors ? 'checked' : '' }}>{{ 'admin.errors_only'|trans }}</label><button class="button primary">{{ 'admin.apply'|trans }}</button><a href="{{ path('app_admin', {days: filters.days}) }}#events">{{ 'admin.clear'|trans }}</a></form>
<div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>{{ 'admin.when'|trans }}</th><th>{{ 'admin.event'|trans }}</th><th>{{ 'admin.who'|trans }}</th><th>IP / {{ 'admin.country'|trans }}</th><th>{{ 'admin.request'|trans }}</th><th>{{ 'admin.result'|trans }}</th></tr></thead><tbody>{% for event in report.events %}<tr><td><time datetime="{{ (event.recorded_at ~ ' UTC')|date('c', 'UTC') }}">{{ (event.recorded_at ~ ' UTC')|date('d.m.Y H:i:s', 'Europe/Warsaw') }}</time></td><td><span class="badge {{ event.status_code >= 400 or event.kind == 'login_failure' ? 'status-failed' : 'status-completed' }}">{{ ('admin.kind.' ~ event.kind)|trans }}</span>{% if event.context.action is defined %}<small>{{ ('admin.action.' ~ event.context.action)|trans }}</small>{% endif %}</td><td>{% if event.context.impersonator_user_id is defined %}<small class="impersonation-log">{{ 'admin.impersonation_actor'|trans }} <a href="{{ path('app_admin_user', {id: event.context.impersonator_user_id}) }}">#{{ event.context.impersonator_user_id }}</a></small>{% endif %}{% if event.actor_id %}<a href="{{ path('app_admin_user', {id: event.actor_id}) }}">{{ event.actor_name ?: ('#' ~ event.actor_id) }}</a>{% else %}{{ event.actor_name ?: 'admin.guest'|trans }}{% endif %}</td><td><code>{{ event.ip ?: '—' }}</code><small>{{ event.country ?: 'admin.unknown'|trans }}{% if event.city %} · {{ event.city }}{% endif %}</small></td><td>{{ event.method }} {{ event.path }}<small>{{ event.context.browser|default('') }} · {{ event.context.device|default('') }}</small><details><summary>{{ 'admin.details'|trans }}</summary><code>{{ event.request_id }}</code>{% if event.referrer_host %}<small>{{ event.referrer_host }}</small>{% endif %}<pre>{{ event.context|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre></details></td><td><strong>{{ event.status_code }}</strong><small>{{ event.duration_ms }} ms</small></td></tr>{% else %}<tr><td colspan="6" class="muted">{{ 'admin.empty'|trans }}</td></tr>{% endfor %}</tbody></table></div>
<div class="admin-pagination">{% if report.page > 1 %}<a class="button secondary" href="{{ path('app_admin', filters|merge({page: report.page - 1})) }}#events">← {{ 'admin.previous'|trans }}</a>{% endif %}<span>{{ 'admin.page'|trans }} {{ report.page }}</span>{% if report.page * 50 < report.count %}<a class="button secondary" href="{{ path('app_admin', filters|merge({page: report.page + 1})) }}#events">{{ 'admin.next'|trans }} →</a>{% endif %}</div>
</section><p class="help-text section">{{ 'admin.retention'|trans }}</p>
{% endblock %}
