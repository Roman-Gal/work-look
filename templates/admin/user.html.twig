{% extends 'base.html.twig' %}
{% block title %}{{ targetUser.email }} · WorkLook{% endblock %}
{% block content %}<a class="back-link" href="{{ path('app_admin_users') }}">← {{ 'admin.users'|trans }}</a><h1 class="admin-email-heading">{{ targetUser.email }}</h1>{% include 'admin/_tabs.html.twig' %}
<section class="panel"><div class="section-title"><h2>{{ 'admin.access'|trans }}</h2><a href="{{ path('app_admin', {q: targetUser.id, days: 90}) }}#events">{{ 'admin.user_activity'|trans }} →</a></div><p>{{ 'admin.verified'|trans }}: {{ (targetUser.isVerified ? 'admin.yes' : 'admin.no')|trans }} · AI: {{ (targetUser.liveAiEnabled ? 'admin.enabled' : 'admin.disabled')|trans }} · {{ 'admin.allowance'|trans }}: {{ targetUser.freeSearchRunId ? 0 : 1 }}</p>{% if not targetUser.administrator %}<form action="{{ path('app_admin_user_ai', {id: targetUser.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('admin_ai_' ~ targetUser.id) }}"><input type="hidden" name="enabled" value="{{ targetUser.liveAiEnabled ? '0' : '1' }}"><button class="button secondary">{{ (targetUser.liveAiEnabled ? 'admin.suspend' : 'admin.enable')|trans }}</button></form>{% endif %}<p class="help-text">{{ 'admin.quota_help'|trans }}</p></section>
<section class="panel section"><h2>{{ 'admin.profile'|trans }}</h2>{{ form_start(form) }}{{ form_widget(form) }}<button class="button primary">{{ 'admin.save_profile'|trans }}</button>{{ form_end(form) }}</section>
<section class="panel section"><h2>{{ 'admin.runs'|trans }}</h2>{% for run in runs %}<a class="run-row" href="{{ path('app_run', {id: run.id}) }}"><div class="grow"><strong>{{ run.createdAt|date('d.m.Y H:i', 'Europe/Warsaw') }}</strong><span>{{ run.id }}</span></div><span class="badge">{{ run.status }}</span> →</a>{% else %}<p class="muted">{{ 'admin.empty'|trans }}</p>{% endfor %}</section>
<section class="panel section"><h2>{{ 'admin.matches'|trans }}</h2>{% for match in matches %}<a class="run-row" href="{{ path('app_match', {id: match.id}) }}"><div class="grow"><strong>{{ match.jobSnapshot.title }}</strong><span>{{ match.status }}</span></div>{{ match.score }}% →</a>{% else %}<p class="muted">{{ 'admin.empty'|trans }}</p>{% endfor %}</section>{% endblock %}
