{% extends 'base.html.twig' %}
{% block title %}{{ 'admin.users'|trans }} · WorkLook{% endblock %}
{% block content %}<span class="eyebrow">WORKLOOK / {{ 'admin.owner'|trans }}</span><h1>{{ 'admin.users'|trans }}</h1>{% include 'admin/_tabs.html.twig' %}
<section class="panel"><form method="get" class="admin-period"><label for="user-search">Email</label><input id="user-search" name="q" value="{{ q }}" maxlength="180"><button class="button primary">{{ 'admin.apply'|trans }}</button></form><p class="muted">{{ count }} {{ 'admin.records'|trans }}</p><div class="admin-table-scroll"><table class="admin-table"><thead><tr><th>Email</th><th>{{ 'admin.created'|trans }}</th><th>{{ 'admin.verified'|trans }}</th><th>AI</th><th>{{ 'admin.allowance'|trans }}</th></tr></thead><tbody>{% for user in users %}<tr><td><a href="{{ path('app_admin_user', {id: user.id}) }}">{{ user.email }} →</a>{% if user.administrator %}<small>{{ 'admin.owner'|trans }}</small>{% endif %}</td><td>{{ user.createdAt|date('d.m.Y H:i', 'Europe/Warsaw') }}</td><td>{{ (user.isVerified ? 'admin.yes' : 'admin.no')|trans }}</td><td>{{ (user.liveAiEnabled ? 'admin.enabled' : 'admin.disabled')|trans }}</td><td>{{ user.freeSearchRunId ? 0 : 1 }}</td></tr>{% else %}<tr><td colspan="5">{{ 'admin.empty'|trans }}</td></tr>{% endfor %}</tbody></table></div><div class="admin-pagination">{% if page > 1 %}<a class="button secondary" href="{{ path('app_admin_users', {q: q, page: page - 1}) }}">← {{ 'admin.previous'|trans }}</a>{% endif %}<span>{{ 'admin.page'|trans }} {{ page }}</span>{% if page * 50 < count %}<a class="button secondary" href="{{ path('app_admin_users', {q: q, page: page + 1}) }}">{{ 'admin.next'|trans }} →</a>{% endif %}</div></section>{% endblock %}
