{% extends 'base.html.twig' %}
{% block title %}{{ 'kb.nav'|trans }} · WorkLook{% endblock %}
{% block content %}<div class="page-heading"><div><span class="eyebrow">WORKLOOK / KNOWLEDGE</span><h1>{{ 'kb.nav'|trans }}</h1><p class="muted">{{ 'kb.intro'|trans }}</p></div><div class="kb-actions"><a class="button secondary" href="{{ path('app_knowledge_prompt_new') }}">{{ 'kb.new_private'|trans }} +</a>{% if is_granted('ROLE_ADMIN') %}<a class="button primary" href="{{ path('app_admin_knowledge_new') }}">{{ 'kb.new_shared'|trans }} +</a>{% endif %}</div></div>
<form method="get" class="admin-period"><label for="kb-q">{{ 'kb.search'|trans }}</label><input id="kb-q" name="q" value="{{ q }}" maxlength="180"><label for="kb-site">{{ 'kb.site'|trans }}</label><select id="kb-site" name="site"><option value="">{{ 'admin.all'|trans }}</option>{% for source in sites %}<option value="{{ source }}" {{ site == source ? 'selected' : '' }}>{{ ('kb.site.' ~ source)|trans }}</option>{% endfor %}</select><button class="button secondary">{{ 'admin.apply'|trans }}</button></form>
<p class="help-text">{{ 'kb.scope_help'|trans }}</p><div class="job-grid">{% for entry in entries %}<article class="panel kb-card"><div class="job-card-top"><span class="source-tag">{{ ('kb.site.' ~ entry.site)|trans }}</span><span class="badge">{{ (entry.owner ? 'kb.private' : 'kb.status.' ~ entry.status)|trans }}</span></div><h2>{{ entry.title }}</h2><p class="description-text">{{ entry.content }}</p><div class="help-text">{{ ('kb.kind.' ~ entry.kind)|trans }} · {{ entry.locale|upper }} · v{{ entry.revision }}{% if entry.reviewedAt %} · {{ 'kb.reviewed'|trans }} {{ entry.reviewedAt|date('d.m.Y') }}{% if entry.reviewedAt < date('-90 days') %} · {{ 'kb.review_due'|trans }}{% endif %}{% endif %}</div>{% if entry.sourceUrl %}<a class="back-link" href="{{ entry.sourceUrl }}" rel="noreferrer" target="_blank">{{ 'kb.source'|trans }} ↗</a>{% endif %}{% if entry.sourceNotes %}<p class="help-text">{{ entry.sourceNotes }}</p>{% endif %}{% if entry.owner %}<a class="button secondary" href="{{ path('app_knowledge_prompt', {id: entry.id}) }}">{{ 'kb.edit'|trans }}</a>{% elseif is_granted('ROLE_ADMIN') %}<a class="button secondary" href="{{ path('app_admin_knowledge_edit', {id: entry.id}) }}">{{ 'kb.edit'|trans }}</a>{% endif %}</article>{% else %}<section class="panel empty-state"><p>{{ 'admin.empty'|trans }}</p></section>{% endfor %}</div><div class="admin-pagination">{% if page > 1 %}<a href="{{ path('app_knowledge', {q: q, site: site, page: page - 1}) }}">← {{ 'admin.previous'|trans }}</a>{% endif %}<span>{{ 'admin.page'|trans }} {{ page }} · {{ count }}</span>{% if page * 30 < count %}<a href="{{ path('app_knowledge', {q: q, site: site, page: page + 1}) }}">{{ 'admin.next'|trans }} →</a>{% endif %}</div>{% endblock %}
