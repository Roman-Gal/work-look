{% extends 'base.html.twig' %}
{% block title %}{{ 'kb.edit'|trans }} · WorkLook{% endblock %}
{% block content %}<a class="back-link" href="{{ path('app_knowledge') }}">← {{ 'kb.nav'|trans }}</a><h1>{{ (shared ? 'kb.shared_editor' : 'kb.private_editor')|trans }}</h1><p class="muted">{{ (shared ? 'kb.publish_help' : 'kb.private_help')|trans }}</p><section class="panel">{{ form_start(form, {attr: {'data-turbo': 'false'}}) }}{{ form_widget(form) }}<button class="button primary">{{ 'kb.save'|trans }}</button>{{ form_end(form) }}</section>{% if not shared and entry.id %}<form class="section" action="{{ path('app_knowledge_prompt_remove', {id: entry.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('prompt_remove_' ~ entry.id) }}"><button class="button secondary">{{ 'kb.remove'|trans }}</button></form>{% endif %}{% endblock %}
