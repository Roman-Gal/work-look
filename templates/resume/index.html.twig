{% extends 'base.html.twig' %}
{% block title %}{{ 'resume.title'|trans }} · WorkLook{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">WORKLOOK / CV</span><h1>{{ 'resume.title'|trans }}</h1><p class="muted">{{ 'resume.intro'|trans }}</p></div><a class="button secondary" href="{{ path('app_profile') }}">{{ 'resume.manual_profile'|trans }} →</a></div>
<div class="resume-flow"><span>1 · {{ 'resume.upload'|trans }}</span><span>2 · {{ 'resume.prompt'|trans }}</span><span>3 · {{ 'resume.review'|trans }}</span></div>
<section class="panel"><h2>{{ 'resume.upload'|trans }}</h2><p class="muted">{{ 'resume.upload_help'|trans }}</p><form action="{{ path('app_resume_upload') }}" method="post" enctype="multipart/form-data" data-turbo="false" class="resume-upload"><input type="hidden" name="_token" value="{{ csrf_token('resume_upload') }}"><div><label for="resume-file">PDF</label><input id="resume-file" type="file" name="resume" accept="application/pdf,.pdf" required></div><button class="button primary">{{ 'resume.upload_button'|trans }}</button></form>{% if draft %}<div class="notice"><strong>{{ draft.filename }}</strong><span>{{ 'resume.pages'|trans({'%count%': draft.pages}) }} · {{ draft.updatedAt|date('d.m.Y H:i', 'Europe/Warsaw') }}</span></div><details><summary>{{ 'resume.extracted'|trans }}</summary><label for="extracted-text">{{ 'resume.source_text'|trans }}</label><textarea id="extracted-text" rows="14" readonly>{{ draft.text }}</textarea></details>{% endif %}</section>
{% if draft %}<section class="panel section"><h2>{{ 'resume.search_context'|trans }}</h2><form action="{{ path('app_resume_notes') }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('resume_notes_' ~ draft.contentHash) }}"><div><label for="resume-request">{{ 'form.request'|trans }}</label><textarea id="resume-request" name="requestText" maxlength="2000" rows="3">{{ draft.requestText }}</textarea></div><div><label for="resume-preferences">{{ 'form.preferences'|trans }}</label><textarea id="resume-preferences" name="preferences" maxlength="3000" rows="3">{{ draft.preferences }}</textarea></div><button class="button secondary">{{ 'resume.save_context'|trans }}</button></form></section>
<div class="admin-split section"><section class="panel"><span class="eyebrow">02 / AI</span><h2>{{ 'resume.prompt'|trans }}</h2><p>{{ 'resume.prompt_help'|trans }}</p><a class="button primary" href="{{ path('app_resume_prompt') }}">{{ 'resume.download_prompt'|trans }} ↓</a><p class="help-text">{{ 'resume.private_help'|trans }}</p><a class="back-link" href="{{ path('app_knowledge') }}">{{ 'kb.nav'|trans }} →</a></section><section class="panel"><span class="eyebrow">03 / {{ 'resume.review'|trans }}</span><h2>{{ 'resume.return_json'|trans }}</h2><p class="muted">{{ 'resume.return_help'|trans }}</p><form action="{{ path('app_resume_prepare') }}" method="post" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('resume_prepare_' ~ draft.contentHash) }}"><div><label for="profile-json">JSON</label><textarea id="profile-json" name="profile_json" rows="9" maxlength="32000" required spellcheck="false">{{ jsonInput }}</textarea></div><button class="button primary">{{ 'resume.preview_profile'|trans }} →</button></form>{% if draft.preparedProfile %}<a class="back-link section" href="{{ path('app_profile', {resume: '1'}) }}">{{ 'resume.open_prepared'|trans }} →</a>{% endif %}</section></div>
<form action="{{ path('app_resume_remove') }}" method="post" class="section" data-turbo="false"><input type="hidden" name="_token" value="{{ csrf_token('resume_remove_' ~ draft.contentHash) }}"><button class="button secondary">{{ 'resume.remove'|trans }}</button><p class="help-text">{{ 'resume.remove_help'|trans }}</p></form>{% endif %}
{% endblock %}
