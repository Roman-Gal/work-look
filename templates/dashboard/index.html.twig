{% extends 'base.html.twig' %}
{% block content %}
<div class="page-heading"><div><div class="eyebrow">{{ 'dashboard.eyebrow'|trans }}</div><h1>{{ 'dashboard.title'|trans }}<span class="green">.</span></h1><p class="muted">{{ 'dashboard.intro'|trans }}</p></div><a class="button secondary" href="{{ path('app_profile') }}">{{ 'dashboard.profile'|trans }}</a></div>
<section class="stats-grid" aria-label="{{ 'dashboard.overview'|trans }}"><div class="stat"><span>{{ 'dashboard.saved'|trans }}</span><strong>{{ matches|length }}<small>{{ 'dashboard.feed'|trans }}</small></strong></div><div class="stat"><span>{{ 'dashboard.recent_runs'|trans }}</span><strong>{{ runs|length }}<small>{{ 'dashboard.history_count'|trans }}</small></strong></div><div class="stat"><span>{{ 'dashboard.active'|trans }}</span><strong>{{ activeCount }}<small>{{ 'dashboard.runs'|trans }}</small></strong></div><div class="stat"><span>{{ 'dashboard.canonical_cv'|trans }}</span><strong class="stat-word">{{ profile and profile.factsText ? 'dashboard.ready'|trans : 'dashboard.add'|trans }}</strong><a href="{{ path('app_profile') }}">{{ profile and profile.factsText ? 'dashboard.update_profile'|trans : 'dashboard.fill_profile'|trans }}</a></div></section>
<div class="dashboard-grid"><section class="panel search-panel"><div class="panel-header"><div><span class="eyebrow">{{ 'dashboard.new_run'|trans }}</span><h2>{{ 'dashboard.find_fit'|trans }}</h2></div><span class="agent-symbol">✳</span></div><p class="muted">{{ 'dashboard.agent_intro'|trans }}</p>
{% if not aiConfigured %}<div class="notice"><strong>{{ 'dashboard.no_ai'|trans }}</strong><span>{{ 'trial.ai_unavailable'|trans }}</span></div>{% endif %}
<div class="notice" data-testid="search-allowance"><strong>{{ 'trial.balance'|trans({'%count%': freeSearches}) }}</strong><span>{{ 'trial.one_free'|trans }}</span></div>
{{ form_start(runForm, {attr: {'data-turbo': 'false'}}) }}{{ form_errors(runForm) }}{{ form_row(runForm.requestText) }}{{ form_row(runForm.sources, {attr: {class: 'source-options'}}) }}{{ form_row(runForm.minimumScore) }}<button class="button primary full" type="submit" {{ not aiConfigured or freeSearches == 0 or not app.user.liveAiEnabled or activeCount > 0 ? 'disabled' : '' }}>✳ {{ 'trial.start_free'|trans }} <span>→</span></button><p class="form-footnote">{{ 'dashboard.no_auto_apply'|trans }}</p>{{ form_end(runForm) }}<button class="button secondary full" type="button" disabled data-testid="future-payment" aria-describedby="payment-note">{{ 'trial.pay_next'|trans }}</button><p id="payment-note" class="form-footnote">{{ 'trial.payment_soon'|trans }}</p></section>
<aside class="panel how-panel"><span class="eyebrow">{{ 'dashboard.flow'|trans }}</span><h2>{{ 'dashboard.context'|trans }}</h2><ol class="steps"><li><span>01</span><div><strong>{{ 'dashboard.step1_title'|trans }}</strong><p>{{ 'dashboard.step1_body'|trans }}</p></div></li><li><span>02</span><div><strong>{{ 'dashboard.step2_title'|trans }}</strong><p>{{ 'dashboard.step2_body'|trans }}</p></div></li><li><span>03</span><div><strong>{{ 'dashboard.step3_title'|trans }}</strong><p>{{ 'dashboard.step3_body'|trans }}</p></div></li><li><span>04</span><div><strong>{{ 'dashboard.step4_title'|trans }}</strong><p>{{ 'dashboard.step4_body'|trans }}</p></div></li></ol><div class="source-footer"><span class="status-dot"></span> SOLID.Jobs · DOU · Djinni</div></aside></div>
<section class="section"><div class="section-title"><h2>{{ 'dashboard.recent_runs'|trans }}</h2><span class="muted">{{ 'dashboard.history'|trans }}</span></div>{% if runs %}<div class="panel run-list">{% for run in runs %}<a class="run-row" href="{{ path('app_run', {id: run.id}) }}"><div class="run-icon">✳</div><div class="grow"><strong>{{ 'dashboard.live_run'|trans }}</strong><span>{{ run.createdAt|date('d.m.Y · H:i', 'Europe/Warsaw') }} · {{ run.sources|join(', ') }}</span></div>{% include 'run/_status.html.twig' %}<span>→</span></a>{% endfor %}</div>{% else %}<div class="empty-state panel"><span class="empty-icon">↗</span><h3>{{ 'dashboard.empty_title'|trans }}</h3><p>{{ 'dashboard.empty_body'|trans }}</p></div>{% endif %}</section>
<section class="section"><div class="section-title"><h2>{{ 'dashboard.matches'|trans }}</h2><span class="muted">{{ 'dashboard.latest'|trans }}</span></div>{% if matches %}<div class="job-grid">{% for match in matches %}{% include 'match/_card.html.twig' %}{% endfor %}</div>{% else %}<div class="empty-state panel compact"><p>{{ 'dashboard.empty_matches'|trans }}</p></div>{% endif %}</section>
{% endblock %}
