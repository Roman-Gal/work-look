# Copy to .env.local on the hosting account; never commit real credentials.
# .env.local selects APP_ENV=prod for web requests; .env.prod.local alone cannot do that.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
DEFAULT_URI=https://YOUR_HOSTNAME
DATABASE_URL="postgresql://DB_USER:URL_ENCODED_PASSWORD@pgsqlX.mydevil.net:5432/DB_NAME?serverVersion=16&charset=utf8"
# MySQL alternative: mysql://USER:PASSWORD@HOST:3306/DB?serverVersion=8.0&charset=utf8mb4
MESSENGER_TRANSPORT_DSN=doctrine://default?queue_name=async&auto_setup=1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
RESUME_PHP_BINARY=/usr/local/bin/php84
PLANNER_INTERNAL_PORT=0
PLANNER_WEBHOOK_SECRET=
TRANSLATOR_INTERNAL_PORT=0
TRANSLATOR_WEBHOOK_SECRET=
REGISTRATION_ENABLED=0
MAILER_FROM=noreply@YOUR_HOSTNAME
MAILER_DSN="smtp://URL_ENCODED_EMAIL:URL_ENCODED_PASSWORD@mail93.mydevil.net:587?require_tls=true"
